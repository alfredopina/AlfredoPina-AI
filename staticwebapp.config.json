{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN",
    "Strict-Transport-Security": "max-age=31536000"
  },
  "routes": [
    {
      "route": "/in-company",
      "rewrite": "/cursos.html"
    },
    {
      "route": "/cursos",
      "redirect": "/in-company",
      "statusCode": 301
    },
    {
      "route": "/cursos.html",
      "redirect": "/in-company",
      "statusCode": 301
    },
    {
      "route": "/agenda",
      "rewrite": "/agenda.html"
    },
    {
      "route": "/recursos",
      "rewrite": "/recursos.html"
    },
    {
      "route": "/aviso-privacidad",
      "rewrite": "/aviso-privacidad.html"
    },
    {
      "route": "/terminos-uso",
      "rewrite": "/terminos-uso.html"
    },
    {
      "route": "/encuesta",
      "rewrite": "/encuesta.html"
    },
    {
      "route": "/diagnostico",
      "rewrite": "/diagnostico.html"
    },
    {
      "route": "/reporte",
      "rewrite": "/reporte-diagnostico.html"
    },
    {
      "route": "/reporte/*",
      "rewrite": "/reporte-diagnostico.html"
    },
    {
      "route": "/reporte-encuesta",
      "rewrite": "/reporte-encuesta.html"
    },
    {
      "route": "/satisfaccion/*",
      "rewrite": "/reporte-encuesta.html"
    },
    {
      "route": "/resultados/*",
      "rewrite": "/reporte-resultados.html"
    },
    {
      "route": "/diploma/*",
      "rewrite": "/diplomas-grupo.html"
    },
    {
      "route": "/propuesta/*",
      "rewrite": "/propuesta.html"
    },
    {
      "route": "/verificar",
      "rewrite": "/verificar.html"
    },
    {
      "route": "/verificar/*",
      "rewrite": "/verificar.html"
    },
    {
      "route": "/api/crearSolicitudPublica"
    },
    {
      "route": "/api/enviarDiagnostico"
    },
    {
      "route": "/api/enviarRespuesta"
    },
    {
      "route": "/api/confirmarVistaPropuesta"
    },
    {
      "route": "/api/responderPropuesta"
    },
    {
      "route": "/api/registrarEventoDiploma"
    },
    {
      "route": "/api/getCatalogoCursos"
    },
    {
      "route": "/api/getCatalogoRecursos"
    },
    {
      "route": "/api/getConfiguracionSitio"
    },
    {
      "route": "/api/getRecursos"
    },
    {
      "route": "/api/availability"
    },
    {
      "route": "/api/getPropuestaPublica"
    },
    {
      "route": "/api/verificarDiploma"
    },
    {
      "route": "/api/getDiplomasGrupoPublico"
    },
    {
      "route": "/api/getLinkEncuestaPublico"
    },
    {
      "route": "/api/getPreguntasEncuesta"
    },
    {
      "route": "/api/getPreguntasDiagnostico"
    },
    {
      "route": "/api/getReporteDiagnosticoPublico"
    },
    {
      "route": "/api/getReporteEncuestaPublico"
    },
    {
      "route": "/api/getReporteCalificacionesPublico"
    },
    {
      "route": "/api/getFirmaPublica"
    },
    {
      "route": "/api/getFotoInstructor"
    },
    {
      "route": "/api/getFotoGrupoReporte"
    },
    {
      "route": "/api/getLogoIntermediario"
    },
    {
      "route": "/api/respaldoAutomatico"
    },
    {
      "route": "/api/notificarSolicitudesAtoradas"
    },
    {
      "route": "/api/enviarResumenSemanal"
    },
    {
      "route": "/api/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/admin",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/admin/*",
      "allowedRoles": ["admin"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  }
}
